{
  "manifest_version": 3,
  "name": "Survivor Yahoo Draft Watcher",
  "version": "0.3.5",
  "description": "Automatically connect Yahoo salary-cap mock rooms to Survivor with teams, budgets, nominations and observed bids.",
  "host_permissions": [
    "https://basketball.fantasysports.yahoo.com/*",
    "https://survivor-production-bdd5.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://basketball.fantasysports.yahoo.com/*"
      ],
      "js": [
        "yahoo-reader.js",
        "capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://survivor-production-bdd5.up.railway.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Survivor draft watcher"
  }
}
